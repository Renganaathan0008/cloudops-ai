APP_NAME=CloudOps AI Backend
ENVIRONMENT=development

# Local backend process. Replace the placeholder in your ignored .env file.
DATABASE_URL=postgresql+psycopg2://cloudops:replace-with-local-password@localhost:5432/cloudops
# Inside the Docker Compose network, use the service hostname `postgres` instead.
# DATABASE_URL=postgresql+psycopg2://cloudops:replace-with-local-password@postgres:5432/cloudops

JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

PROMETHEUS_URL=http://localhost:9090
